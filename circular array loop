#include <stdbool.h>
int getNextIndex(int* nums, int numsSize, int currentIndex) {
    int next = (currentIndex + nums[currentIndex]) % numsSize;
    if (next < 0) {
        next += numsSize; 
    }
    return next;
}
bool circularArrayLoop(int* nums, int numsSize) {
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == 0) {
            continue;
        }
        int slow = i;
        int fast = i;
        bool isForward = nums[i] > 0;
        while (true) {
            if (nums[slow] == 0 || nums[fast] == 0) break;
            if ((nums[slow] > 0) != isForward || (nums[fast] > 0) != isForward) break;
            slow = getNextIndex(nums, numsSize, slow);
            int nextFast = getNextIndex(nums, numsSize, fast);
            if (nums[nextFast] == 0 || (nums[nextFast] > 0) != isForward) break;
            fast = getNextIndex(nums, numsSize, nextFast);
            if (slow == fast) {
                if (slow == getNextIndex(nums, numsSize, slow)) {
                    break; 
                }
                return true;
            }
        }
        slow = i;
        while (nums[slow] != 0 && (nums[slow] > 0) == isForward) {
            int nextSlow = getNextIndex(nums, numsSize, slow);
            nums[slow] = 0;
            slow = nextSlow;
        }
    }
    
    return false;
}
