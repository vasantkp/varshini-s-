#include <string.h>
#include <stdlib.h>
#include <stdbool.h>
char* removeDuplicateLetters(char* s) {
    int last_occurrence[26];
    int len = strlen(s);
    for (int i = 0; i < len; i++) {
        last_occurrence[s[i] - 'a'] = i;
    }
    
    char* stack = (char*)malloc((len + 1) * sizeof(char));
    int top = -1;
    bool in_stack[26] = {false};
    
    for (int i = 0; i < len; i++) {
        char c = s[i];
        if (in_stack[c - 'a']) {
            continue;
        }
        while (top >= 0 && stack[top] > c && last_occurrence[stack[top] - 'a'] > i) {
            in_stack[stack[top] - 'a'] = false;
            top--;
        }
        
        top++;
        stack[top] = c;
        in_stack[c - 'a'] = true;
    }
    
    stack[top + 1] = '\0';
    return stack;
}
